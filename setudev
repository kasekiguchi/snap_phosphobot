#!/usr/bin/env bash
# setudev — 同一VID:PIDのUSBシリアル機器2台に、シリアル番号で固定tty名を割り当てる
#
# 使い方:
#   sudo setudev <leader_serial> <follower_serial>
#   例: sudo setudev SAE70xxxx1 SAE70xxxx2
#
# シリアルに紐付けるので、どのUSBポートに挿しても名前は追従する。

set -euo pipefail

RULE_FILE="/etc/udev/rules.d/99-fixed-usb-serial.rules"
VID="1a86"
PID="55d3"

if [ "$#" -ne 2 ]; then
  echo "使い方: sudo $0 <leader_serial> <follower_serial>" >&2
  echo "  例: sudo $0 SAE70xxxx1 SAE70xxxx2" >&2
  exit 1
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "sudo で実行してください。" >&2
  exit 1
fi

leader_serial="$1"
follower_serial="$2"

if [ "$leader_serial" = "$follower_serial" ]; then
  echo "2つのシリアルが同じです。別々の値を指定してください。" >&2
  exit 1
fi

# 指定シリアルが実際に接続されているか確認(タイプミス検出)
serial_present() {
  local want="$1" d
  for d in /sys/bus/usb/devices/*; do
    [ -f "$d/serial" ]    || continue
    [ -f "$d/idVendor" ]  || continue
    [ -f "$d/idProduct" ] || continue
    if [ "$(cat "$d/serial")" = "$want" ] \
       && [ "$(cat "$d/idVendor")"  = "$VID" ] \
       && [ "$(cat "$d/idProduct")" = "$PID" ]; then
      return 0
    fi
  done
  return 1
}

serial_present "$leader_serial"   || echo "警告: serial '$leader_serial' は現在接続されていません。" >&2
serial_present "$follower_serial" || echo "警告: serial '$follower_serial' は現在接続されていません。" >&2

cat > "$RULE_FILE" <<EOF
# Generated by setudev on $(date)
# VID:PID $VID:$PID — シリアル番号に紐付け
SUBSYSTEM=="tty", ATTRS{idVendor}=="$VID", ATTRS{idProduct}=="$PID", ATTRS{serial}=="$leader_serial", SYMLINK+="ttyLeader"
SUBSYSTEM=="tty", ATTRS{idVendor}=="$VID", ATTRS{idProduct}=="$PID", ATTRS{serial}=="$follower_serial", SYMLINK+="ttyFollower"
EOF

echo "書き込みました: $RULE_FILE"
echo "  ttyLeader   -> serial $leader_serial"
echo "  ttyFollower -> serial $follower_serial"

udevadm control --reload-rules
udevadm trigger --subsystem-match=tty --action=add

echo "完了。確認: ls -l /dev/ttyLeader /dev/ttyFollower"
